{
  "name": "personal-agent",
  "version": "0.0.0",
  "private": true,
  "description": "Reach Claude Code from WhatsApp, email, or a schedule \u2014 one continuous conversation",
  "license": "MIT",
  "author": "Adam Jones (domdomegg)",
  "repository": {
    "type": "git",
    "url": "https://github.com/domdomegg/personal-agent.git"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "personal-agent": "dist/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "npm run build && node ./dist/main.js",
    "test": "vitest run --exclude '**/*.e2e.test.ts'",
    "test:e2e": "vitest run --testTimeout 600000 e2e",
    "test:watch": "vitest --watch --exclude '**/*.e2e.test.ts'",
    "lint": "eslint",
    "clean": "rm -rf dist",
    "build": "tsc --project tsconfig.build.json",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "devDependencies": {
    "@tsconfig/node-lts": "^22.0.2",
    "@types/node": "^22.15.3",
    "eslint": "^9.32.0",
    "eslint-config-domdomegg": "^2.0.9",
    "tsconfig-domdomegg": "^1.0.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.0"
  }
}
