#!/bin/sh
# (Re)start Google Chrome on the agent's desktop, as the `desktop` user, with the
# DevTools protocol on 127.0.0.1:9222 so the agent can drive pages over CDP
# (reliable) and fall back to xdotool for anything else. The profile lives in
# the shared dir on the volume, so logins persist. Any arguments are passed
# through, e.g. a URL to open.
#
# Chrome keeps its own sandbox: this pod allows unprivileged user namespaces
# (kernel.unprivileged_userns_clone=1) and Chrome runs as the non-root
# `desktop` user, so the namespace sandbox works without --no-sandbox (verified
# 2026-08-24 on Chromium). --disable-dev-shm-usage: /dev/shm is tiny in a
# container. --password-store=basic: no keyring daemon here, and without it
# Chrome's saved/synced passwords are unavailable. Script keeps its old name so
# nothing that calls it needs to change.
set -u
SHARED=${DESKTOP_SHARED:-/home/agent/desktop}
pkill -u desktop -x chrome 2>/dev/null || true
sleep 0.5
setsid -f runuser -u desktop -- env DISPLAY="${DESKTOP_DISPLAY:-:1}" HOME=/home/desktop \
	google-chrome-stable --disable-dev-shm-usage --disable-gpu --password-store=basic \
	--remote-debugging-port=9222 --user-data-dir="$SHARED/profile" \
	--no-first-run --no-default-browser-check --window-size=1400,860 --window-position=20,20 \
	"$@" >/tmp/desktop/chromium.log 2>&1
i=0; until curl -fsS http://127.0.0.1:9222/json/version >/dev/null 2>&1 || [ $i -ge 40 ]; do i=$((i + 1)); sleep 0.25; done
curl -fsS http://127.0.0.1:9222/json/version | grep -m1 '"Browser"' || { echo "[desktop] chrome did not come up; see /tmp/desktop/chromium.log" >&2; exit 1; }
